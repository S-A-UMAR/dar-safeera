{
  "version": 2,
  "builds": [
    {
      "src": "darsafeera/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "darsafeera/wsgi.py"
    }
  ]
}
